module main
import std

int main() {
    int hit = 0

    switch (1) {
        case 1:
            hit += 1
            fallthrough
        case 2:
            hit += 10
        default:
            hit += 100
    }

    if (hit == 11) {
        std.out.printf("PASS: explicit fallthrough works\n")
        return 0
    }

    std.out.printf("FAIL: expected hit=11, got %d\n", hit)
    return 1
}
