module core_test
import std

// COIL-127 coverage: switch (11.2) and loops (11.3).

int classify(int v) {
    int r = 0
    switch (v) {
        case 1:
            r = 10
        case 2:
            r = 20
        case 3:
            fallthrough
        default:
            r = r + 1
    }
    return r
}

int main() {
    // No implicit fallthrough: case 1 and 2 stand alone.
    if (classify(1) != 10) { std.out.printf("FAIL: switch case 1\n"); return 1 }
    if (classify(2) != 20) { std.out.printf("FAIL: switch case 2\n"); return 1 }
    // Explicit fallthrough: case 3 runs, then default adds 1.
    if (classify(3) != 1) { std.out.printf("FAIL: switch fallthrough\n"); return 1 }
    // No matching case: default only.
    if (classify(9) != 1) { std.out.printf("FAIL: switch default\n"); return 1 }

    // do-while runs its body at least once.
    int i = 10
    do {
        i = i + 1
    } while (i < 3)
    if (i != 11) { std.out.printf("FAIL: do-while once\n"); return 1 }

    int j = 0
    do {
        j = j + 1
    } while (j < 3)
    if (j != 3) { std.out.printf("FAIL: do-while loop\n"); return 1 }

    std.out.printf("PASS: 13-switch-loops\n")
    return 0
}
