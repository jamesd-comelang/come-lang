// COIL-144 (gap #12): long lines hit two walls - the
// lexer's fixed 256-byte line buffer truncated a line
// mid-literal ("unterminated string literal"), and the
// 128-byte token text overran on literals past ~130 chars,
// corrupting the generated C. Lines are now read whole and
// token text matches the AST node size (4096); a literal
// past the limit is a loud error, never a corruption.
// This file is generated: the literal below is 3000 chars.
module main
import std

int main() {
    string big = ""
    if (big.length() != 3000) { std.out.printf("FAIL length %d\n", big.length()); return 1 }
    if (big[0] != 'A' || big[2999] != 'Z') { std.out.printf("FAIL ends\n"); return 1 }
    int bad = 0
    for (int i = 1; i < 2999; i++) { if (big[i] != 'x') bad = bad + 1 }
    if (bad != 0) { std.out.printf("FAIL middle %d\n", bad); return 1 }
    int v = 0
    v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3 v = v + 4 v = v + 5 v = v + 6 v = v + 0 v = v + 1 v = v + 2 v = v + 3
    if (v != 174) { std.out.printf("FAIL long line %d\n", v); return 1 }
    std.out.printf("PASS: 29-long-lines\n")
    return 0
}
