module main
import std

// COIL-120 fixture: the scheduler interleaves coroutines
// deterministically under yield, locals and buffers survive
// every switch, and a coroutine that never yields still runs
// to completion. tests/run_coro_test.sh diffs this program's
// stdout against the expected trace.

coroutine ticker(string tag, int n) {
    int i = 0
    while (i < n) {
        std.out.printf("%s%d ", tag, i)
        i = i + 1
        yield
    }
}

coroutine summer(int n) {
    int total = 0
    int vals[]
    int i = 1
    while (i <= n) {
        total = total + i
        vals.append(i * 10)
        yield
        i = i + 1
    }
    string label = "summer"
    std.out.printf("%s total=%d vals=%d last=%d\n", label, total, vals.length(), vals[n - 1])
}

coroutine noop() {
    std.out.printf("noop\n")
}

int main() {
    spawn ticker("A", 3)
    spawn ticker("B", 3)
    int i = 0
    while (i < 4) {
        std.out.printf("M%d ", i)
        i = i + 1
        yield
    }
    std.out.printf("\n")
    spawn summer(5)
    spawn noop()
    int k = 0
    while (k < 8) {
        yield
        k = k + 1
    }
    std.out.printf("done\n")
    return 0
}
