module main
import std

// COIL-125 fixture: a genuine deadlock. The worker waits for
// a message on its end; main waits for a message on the
// other end; nobody will ever write. The runtime must
// report the deadlock and exit, not hang (spec 9.3).

coroutine waiter(link s) {
    string v = s.read()
    std.out.printf("unreachable %s\n", v)
}

int main() {
    (a, b) = colink()
    spawn waiter(a)
    string v = b.read()
    std.out.printf("unreachable %s\n", v)
    return 0
}
