// COIL-157: scope contexts (spec 7). Buffers a loop iteration
// creates die at the iteration's end; buffers stored into
// longer-lived variables move scopes with them. The escape
// lines below are diffed exactly; the VmHWM line is checked
// separately by run_map_scope_test.sh (peak RSS under 50 MB
// for 20,000 builds of a 147-entry map - the unfixed
// compiler leaks ~30 KB per build, about 600 MB here).
module main

import std
import kwtab

// The 147-entry literal is generated (same allocation shape
// as a keyword table: the map grows 16 -> 256 entries).
map{string, int} build_kw() {
    map{string, int} m = {"k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4, "k5": 5, "k6": 6, "k7": 7, "k8": 8, "k9": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19, "k20": 20, "k21": 21, "k22": 22, "k23": 23, "k24": 24, "k25": 25, "k26": 26, "k27": 27, "k28": 28, "k29": 29, "k30": 30, "k31": 31, "k32": 32, "k33": 33, "k34": 34, "k35": 35, "k36": 36, "k37": 37, "k38": 38, "k39": 39, "k40": 40, "k41": 41, "k42": 42, "k43": 43, "k44": 44, "k45": 45, "k46": 46, "k47": 47, "k48": 48, "k49": 49, "k50": 50, "k51": 51, "k52": 52, "k53": 53, "k54": 54, "k55": 55, "k56": 56, "k57": 57, "k58": 58, "k59": 59, "k60": 60, "k61": 61, "k62": 62, "k63": 63, "k64": 64, "k65": 65, "k66": 66, "k67": 67, "k68": 68, "k69": 69, "k70": 70, "k71": 71, "k72": 72, "k73": 73, "k74": 74, "k75": 75, "k76": 76, "k77": 77, "k78": 78, "k79": 79, "k80": 80, "k81": 81, "k82": 82, "k83": 83, "k84": 84, "k85": 85, "k86": 86, "k87": 87, "k88": 88, "k89": 89, "k90": 90, "k91": 91, "k92": 92, "k93": 93, "k94": 94, "k95": 95, "k96": 96, "k97": 97, "k98": 98, "k99": 99, "k100": 100, "k101": 101, "k102": 102, "k103": 103, "k104": 104, "k105": 105, "k106": 106, "k107": 107, "k108": 108, "k109": 109, "k110": 110, "k111": 111, "k112": 112, "k113": 113, "k114": 114, "k115": 115, "k116": 116, "k117": 117, "k118": 118, "k119": 119, "k120": 120, "k121": 121, "k122": 122, "k123": 123, "k124": 124, "k125": 125, "k126": 126, "k127": 127, "k128": 128, "k129": 129, "k130": 130, "k131": 131, "k132": 132, "k133": 133, "k134": 134, "k135": 135, "k136": 136, "k137": 137, "k138": 138, "k139": 139, "k140": 140, "k141": 141, "k142": 142, "k143": 143, "k144": 144, "k145": 145, "k146": 146}
    return m
}

map{string, int} build_scores() {
    map{string, int} m = {"a": 1, "b": 2}
    return m
}

string pick_word(int i) {
    if (i == 0) {
        return "alpha"
    }
    if (i == 1) {
        return "beta"
    }
    return "gamma"
}

int main() {
    // A string built fresh each iteration, kept outward:
    // the last iteration's value must survive.
    string out = ""
    for (int i = 0; i < 3; i++) {
        out = pick_word(i)
    }
    std.out.printf("escape-string: %s\n", out)

    // A map returned from a function, read after return.
    map{string, int} scores = build_scores()
    std.out.printf("escape-map-return: %d\n", scores["a"] + scores["b"])

    // A whole map assigned to an instance field in create(),
    // read through the instance after create() returned.
    var kt = kwtab.create()
    std.out.printf("escape-instance-map: %d\n", kt.code("SELECT") + kt.code("FROM"))
    kt.destroy()

    // A map built in a loop, assigned outward, read after.
    map{string, int} outer_map
    for (int i = 0; i < 3; i++) {
        map{string, int} lm = {"x": i}
        outer_map = lm
    }
    std.out.printf("escape-map-assign: %d\n", outer_map["x"])

    // A string built in an inner scope, put into an outer map.
    map{string, string} sm
    {
        string inner = "deep"
        sm["k"] = inner
    }
    std.out.printf("escape-map-put: %s\n", sm["k"])

    // Strings appended in a loop, read after the loop.
    string words[]
    for (int i = 0; i < 3; i++) {
        words.append(pick_word(i))
    }
    std.out.printf("escape-array-append: %s %s %s\n", words[0], words[1], words[2])

    // The leak check: 20,000 builds of a 147-entry map.
    // The total proves the maps really held their entries.
    int total = 0
    for (int i = 0; i < 20000; i++) {
        map{string, int} m = build_kw()
        total = total + m["k146"]
    }
    std.out.printf("escape-total: %d\n", total)

    FILE in
    if (!in.open("/proc/self/status", "r")) {
        return 1
    }
    string line = in.gets()
    while (line.length() > 0) {
        if (line.find("VmHWM:") >= 0) {
            std.out.printf("%s", line)
            break
        }
        line = in.gets()
    }
    return 0
}
