module stateful

export (build, count_of, seed)

// The lifecycle pair: what makes this module instantiable
// (COIL-156). These two are empty - the state below is
// plain fields - but both must be defined.
void create() {
}

void destroy() {
}

int cache = 0

void seed(int v) {
    cache = v
}

map{string, int} build() {
    map{string, int} t = {"a": 1}
    return t
}

int count_of(map{string, int} table, string key) {
    return table[key] + cache
}
