module main
import std

int loop_while() {
    int count = 0
    int i = 0
    while (i < 3) {
        string u = "x" + "y"
        if (u == "xy") {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

int loop_for() {
    int count = 0
    for (int i = 0; i < 3; i++) {
        string v = "p" + "q"
        if (v.length() == 2) {
            count = count + 1
        }
    }
    return count
}

int printf_case() {
    string p = "h" + "i"
    std.out.printf("%s\n", p)
    return 1
}

int printf_loop() {
    int count = 0
    int i = 0
    while (i < 2) {
        string w = "j" + "k"
        std.out.printf("%s\n", w)
        count = count + 1
        i = i + 1
    }
    return count
}

string outer_assign() {
    string t = "a" + "b"
    int i = 0
    while (i < 2) {
        t = "c" + "d"
        i = i + 1
    }
    return t
}

int showlen(string s) {
    return s.length()
}

int call_arg() {
    string c = "e" + "f"
    return showlen(c)
}

int main() {
    if (loop_while() == 3) {
        std.out.printf("ok loop_while\n")
    } else {
        std.out.printf("FAIL loop_while\n")
    }
    if (loop_for() == 3) {
        std.out.printf("ok loop_for\n")
    } else {
        std.out.printf("FAIL loop_for\n")
    }
    if (printf_case() == 1) {
        std.out.printf("ok printf\n")
    } else {
        std.out.printf("FAIL printf\n")
    }
    if (printf_loop() == 2) {
        std.out.printf("ok printf_loop\n")
    } else {
        std.out.printf("FAIL printf_loop\n")
    }
    if (outer_assign() == "cd") {
        std.out.printf("ok outer_assign\n")
    } else {
        std.out.printf("FAIL outer_assign\n")
    }
    if (call_arg() == 2) {
        std.out.printf("ok call_arg\n")
    } else {
        std.out.printf("FAIL call_arg\n")
    }
    return 0
}
