module main
import std

int loop_while() {
    int count = 0
    int i = 0
    while (i < 3) {
        string u = "x" + "y"
        if (u == "xy") {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

int loop_for() {
    int count = 0
    for (int i = 0; i < 3; i++) {
        string v = "p" + "q"
        if (v.length() == 2) {
            count = count + 1
        }
    }
    return count
}

int printf_case() {
    string p = "h" + "i"
    std.out.printf("%s\n", p)
    return 1
}

int printf_loop() {
    int count = 0
    int i = 0
    while (i < 2) {
        string w = "j" + "k"
        std.out.printf("%s\n", w)
        count = count + 1
        i = i + 1
    }
    return count
}

int main() {
    if (loop_while() == 3 && loop_for() == 3 && printf_case() == 1 && printf_loop() == 2) {
        std.out.printf("ok pos\n")
    } else {
        std.out.printf("FAIL pos\n")
    }
    return 0
}
