module main
import std

string ret_view(string s) {
    return s.view(0, 5)
}

int check(string t) {
    if (t == "hello") {
        return 1
    }
    return 0
}

int main() {
    string s = "hello world"
    string w = "héllo"
    if (s.view(0, 5) == "hello") {
        std.out.printf("view eq hello\n")
    } else {
        std.out.printf("FAIL eq hello\n")
    }
    if (s.view(6, 11) == "world") {
        std.out.printf("view eq world\n")
    } else {
        std.out.printf("FAIL eq world\n")
    }
    if (s.view(0, 5) != "world") {
        std.out.printf("view ne\n")
    } else {
        std.out.printf("FAIL ne\n")
    }
    if (s.view(6, 11).length() == 5) {
        std.out.printf("view len suffix\n")
    } else {
        std.out.printf("FAIL len suffix\n")
    }
    if (s.view(0, 5).length() == 5) {
        std.out.printf("view len prefix\n")
    } else {
        std.out.printf("FAIL len prefix\n")
    }
    if (w.view(0, 2) == "hé") {
        std.out.printf("view utf8 eq\n")
    } else {
        std.out.printf("FAIL utf8 eq\n")
    }
    if (w.view(1, 3).length() == 2) {
        std.out.printf("view utf8 len\n")
    } else {
        std.out.printf("FAIL utf8 len\n")
    }
    if (s.view(0, 11).view(6, 11) == "world") {
        std.out.printf("view nested\n")
    } else {
        std.out.printf("FAIL nested\n")
    }
    if (s.byte_view(0, 5).length() == 5) {
        std.out.printf("view byte len\n")
    } else {
        std.out.printf("FAIL byte len\n")
    }
    if (s.byte_view(0, 5)[0] == 104) {
        std.out.printf("view byte idx\n")
    } else {
        std.out.printf("FAIL byte idx\n")
    }
    byte[] bb = s.byte_view(0, 5)
    if (bb[0] == 104 && bb.length() == 5) {
        std.out.printf("view byte stored\n")
    } else {
        std.out.printf("FAIL byte stored\n")
    }
    if (check(s.view(0, 5)) == 1) {
        std.out.printf("view call arg\n")
    } else {
        std.out.printf("FAIL call arg\n")
    }
    string v = s.view(0, 5)
    if (v == "hello") {
        std.out.printf("view stored\n")
    } else {
        std.out.printf("FAIL stored\n")
    }
    if (ret_view(s) == "hello") {
        std.out.printf("view returned\n")
    } else {
        std.out.printf("FAIL returned\n")
    }
    map{string, string} m
    m["k"] = s.view(0, 5)
    if (m["k"] == "hello") {
        std.out.printf("view map store\n")
    } else {
        std.out.printf("FAIL map store\n")
    }
    string[] arr
    arr.append(s.view(0, 5))
    if (arr[0] == "hello") {
        std.out.printf("view array store\n")
    } else {
        std.out.printf("FAIL array store\n")
    }
    std.out.printf("view printf %s\n", s.view(0, 5))
    return 0
}
