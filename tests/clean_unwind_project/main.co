module main
import std

int early(int x) {
    if (x == 3) {
        return 99
    }
    return x
}

int main() {
    // A: break from a clean loop body enclosed in a clean
    // if block. Lexical loop depth is 1 (the if), runtime
    // depth is 0 (the if pushes nothing). Step 5 must emit
    // pop_to_depth(0), not (1).
    int r = 0
    int x = 0
    if (1 == 1) {
        while (x < 10) {
            if (x == 4) { break }
            r = r + x
            x = x + 1
        }
    }
    std.out.printf("A %d %d\n", r, x)
    // B: continue from a clean loop body, many iterations.
    // Odd sum 1+3+...+99 = 2500; c ends at 100.
    int total = 0
    int c = 0
    while (c < 100) {
        c = c + 1
        if (c % 2 == 0) {
            continue
        }
        total = total + c
    }
    std.out.printf("B %d %d\n", total, c)
    // C: break from a checkpoint loop body (string concat
    // of outer strings is arena-only, so the body is
    // checkpoint, not clean and not full). Break at j==2
    // after two adds of len 2: total 4, j 2.
    string a = "x"
    string b = "y"
    int ctotal = 0
    int j = 0
    while (j < 5) {
        string t = a + b
        if (j == 2) { break }
        ctotal = ctotal + t.length()
        j = j + 1
    }
    std.out.printf("C %d %d\n", ctotal, j)
    // D: return from a clean if block in a helper.
    int d1 = early(3)
    int d2 = early(5)
    std.out.printf("D %d %d\n", d1, d2)
    // E: break from a clean loop enclosed in TWO clean
    // if blocks. Lexical loop depth is 2, runtime is 0.
    int e = 0
    int y = 0
    if (1 == 1) {
        if (2 == 2) {
            while (y < 5) {
                if (y == 2) { break }
                e = e + y
                y = y + 1
            }
        }
    }
    std.out.printf("E %d %d\n", e, y)
    return 0
}
