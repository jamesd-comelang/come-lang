module main
import std

int first() {
    string a = "a"
    string b = "b"
    string s = ""
    s = a + b
    if (s == "ab") {
        return 1
    }
    return 0
}

int first_lit() {
    string a = "a"
    string b = "b"
    string s = "x"
    s = a + b
    if (s == "ab") {
        return 1
    }
    return 0
}

int first_multi() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    string s = ""
    s = a + b
    s = c + d
    if (s == "cd") {
        return 1
    }
    return 0
}

int main() {
    if (first() == 1 && first_lit() == 1 && first_multi() == 1) {
        std.out.printf("ok pos\n")
    } else {
        std.out.printf("FAIL pos\n")
    }
    return 0
}
