module main
import std

int cont_append() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    string[] arr
    arr.append(a + b)
    arr.append(c + d)
    if (arr[0] == "ab" && arr[1] == "cd") {
        return 1
    }
    return 0
}

int cont_index() {
    string a = "a"
    string b = "b"
    string[] arr
    arr.append("x")
    arr[0] = a + b
    if (arr[0] == "ab") {
        return 1
    }
    return 0
}

int cont_loop_body() {
    string a = "a"
    string b = "b"
    int i = 0
    int ok = 1
    while (i < 2) {
        string[] arr
        arr.append(a + b)
        if (arr[0] != "ab") {
            ok = 0
        }
        i = i + 1
    }
    return ok
}

int main() {
    if (cont_append() == 1 && cont_index() == 1 && cont_loop_body() == 1) {
        std.out.printf("ok pos\n")
    } else {
        std.out.printf("FAIL pos\n")
    }
    return 0
}
