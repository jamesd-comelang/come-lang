module main
import std

int multi() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    string s = a + b
    s = c + d
    if (s == "cd") {
        return 1
    }
    return 0
}

int multi_self() {
    string a = "a"
    string b = "b"
    string s = a + b
    s = s + "!"
    if (s == "ab!") {
        return 1
    }
    return 0
}

string show(string x) {
    return x
}

int multi_bad() {
    string a = "a"
    string b = "b"
    string s = a + b
    s = show(s)
    if (s == "ab") {
        return 1
    }
    return 0
}

int multi_store() {
    string a = "a"
    string b = "b"
    string[] arr
    string s = a + b
    arr.append(s)
    if (arr[0] == "ab") {
        return 1
    }
    return 0
}

int main() {
    if (multi() == 1) {
        std.out.printf("ok multi\n")
    } else {
        std.out.printf("FAIL multi\n")
    }
    if (multi_self() == 1) {
        std.out.printf("ok multi_self\n")
    } else {
        std.out.printf("FAIL multi_self\n")
    }
    if (multi_bad() == 1) {
        std.out.printf("ok multi_bad\n")
    } else {
        std.out.printf("FAIL multi_bad\n")
    }
    if (multi_store() == 1) {
        std.out.printf("ok multi_store\n")
    } else {
        std.out.printf("FAIL multi_store\n")
    }
    return 0
}
