module main
import std

int multi() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    string s = a + b
    s = c + d
    if (s == "cd") {
        return 1
    }
    return 0
}

int multi_self() {
    string a = "a"
    string b = "b"
    string s = a + b
    s = s + "!"
    if (s == "ab!") {
        return 1
    }
    return 0
}

int main() {
    if (multi() == 1 && multi_self() == 1) {
        std.out.printf("ok pos\n")
    } else {
        std.out.printf("FAIL pos\n")
    }
    return 0
}
