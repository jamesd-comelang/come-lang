module main
import std

int map_str() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    map{string, string} m
    m["k1"] = a + b
    m["k2"] = c + d
    if (m["k1"] == "ab" && m["k2"] == "cd") {
        return 1
    }
    return 0
}

int map_int() {
    map{string, int} m
    m["k"] = 42
    if (m["k"] == 42) {
        return 1
    }
    return 0
}

int map_loop_body() {
    string a = "a"
    string b = "b"
    int i = 0
    int ok = 1
    while (i < 2) {
        map{string, string} m
        m["k"] = a + b
        if (m["k"] != "ab") {
            ok = 0
        }
        i = i + 1
    }
    return ok
}

int map_literal() {
    string a = "a"
    string b = "b"
    map{string, string} m = {"k": a + b}
    if (m["k"] == "ab") {
        return 1
    }
    return 0
}

map{string, string} map_return() {
    string a = "a"
    string b = "b"
    map{string, string} m
    m["k"] = a + b
    return m
}

int showlen(map{string, string} a) {
    return a.length()
}

int map_callarg() {
    string a = "a"
    string b = "b"
    map{string, string} m
    m["k"] = a + b
    if (showlen(m) == 1) {
        return 1
    }
    return 0
}

int map_loop_outer() {
    string a = "a"
    string b = "b"
    map{string, string} m
    int i = 0
    while (i < 2) {
        m["k"] = a + b
        i = i + 1
    }
    if (m["k"] == "ab") {
        return 1
    }
    return 0
}

int main() {
    if (map_str() == 1) {
        std.out.printf("ok map_str\n")
    } else {
        std.out.printf("FAIL map_str\n")
    }
    if (map_int() == 1) {
        std.out.printf("ok map_int\n")
    } else {
        std.out.printf("FAIL map_int\n")
    }
    if (map_loop_body() == 1) {
        std.out.printf("ok map_loop_body\n")
    } else {
        std.out.printf("FAIL map_loop_body\n")
    }
    if (map_literal() == 1) {
        std.out.printf("ok map_literal\n")
    } else {
        std.out.printf("FAIL map_literal\n")
    }
    map{string, string} r = map_return()
    if (r["k"] == "ab") {
        std.out.printf("ok map_return\n")
    } else {
        std.out.printf("FAIL map_return\n")
    }
    if (map_callarg() == 1) {
        std.out.printf("ok map_callarg\n")
    } else {
        std.out.printf("FAIL map_callarg\n")
    }
    if (map_loop_outer() == 1) {
        std.out.printf("ok map_loop_outer\n")
    } else {
        std.out.printf("FAIL map_loop_outer\n")
    }
    return 0
}
