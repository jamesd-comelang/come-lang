module main
import std

int map_str() {
    string a = "a"
    string b = "b"
    string c = "c"
    string d = "d"
    map{string, string} m
    m["k1"] = a + b
    m["k2"] = c + d
    if (m["k1"] == "ab" && m["k2"] == "cd") {
        return 1
    }
    return 0
}

int map_int() {
    map{string, int} m
    m["k"] = 42
    if (m["k"] == 42) {
        return 1
    }
    return 0
}

int map_loop_body() {
    string a = "a"
    string b = "b"
    int i = 0
    int ok = 1
    while (i < 2) {
        map{string, string} m
        m["k"] = a + b
        if (m["k"] != "ab") {
            ok = 0
        }
        i = i + 1
    }
    return ok
}

int main() {
    if (map_str() == 1 && map_int() == 1 && map_loop_body() == 1) {
        std.out.printf("ok pos\n")
    } else {
        std.out.printf("FAIL pos\n")
    }
    return 0
}
