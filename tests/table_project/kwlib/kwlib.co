module kwlib

// A build-once keyword table (COIL-142): the map lives at
// module level, create() fills it once per instance, and
// the lookup just reads it - no per-call rebuild.
map{string, int} codes

void create() {
    codes["SELECT"] = 139
    codes["FROM"] = 141
    codes["WHERE"] = 150
}

// The other half of the pair (COIL-156): nothing to
// release - the table dies with the instance's root.
void destroy() {
}

int code(string word) {
    return codes[word]
}

int size() {
    return codes.length()
}
