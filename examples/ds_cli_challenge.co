}

void print_explanation(int id) {
    switch (id) {
        case 1: std.out.printf("Key: array addressing computes base plus index times item size.\n")
        case 2: std.out.printf("Key: rare resize copies are spread across many cheap appends.\n")
        case 3: std.out.printf("Key: binary search discards half only when ordering is reliable.\n")
        case 4: std.out.printf("Key: stability matters when equal keys carry secondary data.\n")
        case 5: std.out.printf("Key: range sum becomes prefix[right] minus prefix[left].\n")
        case 6: std.out.printf("Key: each pointer moves inward at most n times total.\n")
        case 7: std.out.printf("Key: head and tail wrap around inside the fixed capacity.\n")
        case 8: std.out.printf("Key: store only non-default cells when the space is sparse.\n")
        case 9: std.out.printf("Key: packed order requires closing the gap after deletion.\n")
        case 10: std.out.printf("Key: lower_bound is the insertion point before equal or larger items.\n")
        case 11: std.out.printf("Key: rewiring one next link and the new node is constant work.\n")
        case 12: std.out.printf("Key: singly linked nodes do not know who points to them.\n")
        case 13: std.out.printf("Key: push and pop happen at the same end.\n")
        case 14: std.out.printf("Key: enqueue at back and dequeue at front.\n")
        case 15: std.out.printf("Key: the stack keeps candidates in useful sorted order.\n")
        case 16: std.out.printf("Key: a queue processes nodes by increasing distance layer.\n")
        case 17: std.out.printf("Key: a stack follows one path deeply before backtracking.\n")
        case 18: std.out.printf("Key: deque means double-ended queue.\n")
        case 19: std.out.printf("Key: pointer chasing often misses cache lines.\n")
        case 20: std.out.printf("Key: dummy nodes make empty and one-element cases look ordinary.\n")
        case 21: std.out.printf("Key: hashing maps a key directly to a small bucket region on average.\n")
        case 22: std.out.printf("Key: collisions happen when different keys map to the same bucket.\n")
        case 23: std.out.printf("Key: high load usually means more probes or longer chains.\n")
        case 24: std.out.printf("Key: even spread avoids hot buckets.\n")
        case 25: std.out.printf("Key: heap order keeps the best item at the root.\n")
        case 26: std.out.printf("Key: heap repair moves along the tree height.\n")
        case 27: std.out.printf("Key: priority queues expose the current best priority item.\n")
        case 28: std.out.printf("Key: bloom filters can say maybe present, or definitely absent.\n")
        case 29: std.out.printf("Key: the map finds entries; the list maintains recency order.\n")
        case 30: std.out.printf("Key: more buckets lower average collision cost.\n")
        case 31: std.out.printf("Key: left subtree, node, right subtree follows BST ordering.\n")
        case 32: std.out.printf("Key: balance keeps tree height logarithmic.\n")
        case 33: std.out.printf("Key: rotations and color or height rules control height.\n")
        case 34: std.out.printf("Key: trie edges consume characters of a key prefix.\n")
        case 35: std.out.printf("Key: a range touches logarithmically many segment nodes.\n")
        case 36: std.out.printf("Key: Fenwick indexes jump by lowbit values.\n")
        case 37: std.out.printf("Key: compression flattens trees while union rank limits height.\n")
        case 38: std.out.printf("Key: cycles make a valid topological order impossible.\n")
        case 39: std.out.printf("Key: connected and acyclic forces exactly n minus one edges.\n")
        case 40: std.out.printf("Key: binary lifting precomputes 2^k ancestors.\n")
        case 41: std.out.printf("Key: BFS expands by edge-count distance layers.\n")
        case 42: std.out.printf("Key: negative edges can invalidate Dijkstra's greedy choice.\n")
        case 43: std.out.printf("Key: repeated relaxation exposes negative cycles.\n")
        case 44: std.out.printf("Key: MST connects all vertices with minimum total edge weight.\n")
        case 45: std.out.printf("Key: sparse graphs have far fewer edges than V squared.\n")
        case 46: std.out.printf("Key: a matrix reserves one cell for every vertex pair.\n")
        case 47: std.out.printf("Key: a back edge to an active node indicates a directed cycle.\n")
        case 48: std.out.printf("Key: removing zero-indegree nodes simulates prerequisite completion.\n")
        case 49: std.out.printf("Key: DP stores reusable subproblem answers by state.\n")
        case 50: std.out.printf("Key: undo removes the most recent action first.\n")
        default: std.out.printf("No explanation.\n")
    }
}

void check_level(int level, int answer) {
    int expected = correct_answer(level)
    if (expected == 0) {
        std.out.printf("Invalid level: %d\n", level)
        return
    }
    if (answer < 1) {
        std.out.printf("Answer must be 1..4.\n")
        return
    }
    if (answer > 4) {
        std.out.printf("Answer must be 1..4.\n")
        return
    }
    if (answer == expected) {
        std.out.printf("PASS: level %d cleared.\n", level)
    } else {
        std.out.printf("MISS: level %d expected %d, got %d.\n", level, expected, answer)
    }
    print_explanation(level)
}

void run_all(string args[]) {
    if (args.len() < 52) {
        std.out.printf("Need 50 answers after 'all'. Example: ds_cli_challenge all 1 2 3 ...\n")
        return
    }

    int score = 0
    for (int i = 1; i <= TOTAL_LEVELS; i++) {
        int arg_pos = i + 1
        int got = (int) args[arg_pos].tol()
        int expected = correct_answer(i)
        if (got == expected) {
            score = score + 1
        } else {
            std.out.printf("Level %d missed: expected %d, got %d.\n", i, expected, got)
        }
    }

    std.out.printf("Final score: %d / %d\n", score, TOTAL_LEVELS)
}

int main(string args[]) {
    if (args.len() < 2) {
        print_usage()
        return 0
    }

    string cmd = args[1]

    if (cmd.casecmp("list") == 0) {
        print_levels()
        return 0
    }

    if (cmd.casecmp("study") == 0) {
        if (args.len() < 3) {
            std.out.printf("study needs a level number.\n")
            return 1
        }
        int level = (int) args[2].tol()
        if (level < 1) {
            std.out.printf("Level must be 1..50.\n")
            return 1
        }
        if (level > TOTAL_LEVELS) {
            std.out.printf("Level must be 1..50.\n")
            return 1
        }
        print_question(level)
        print_explanation(level)
        return 0
    }

    if (cmd.casecmp("all") == 0) {
        run_all(args)
        return 0
    }

    int level = (int) cmd.tol()
    if (level < 1) {
        std.out.printf("Unknown command or level. Use 'list' to see ranges.\n")
        return 1
    }
    if (level > TOTAL_LEVELS) {
        std.out.printf("Level must be 1..50.\n")
        return 1
    }

    print_question(level)
    if (args.len() < 3) {
        std.out.printf("Answer with: ds_cli_challenge %d <1-4>\n", level)
        return 0
    }

    int answer = (int) args[2].tol()
    check_level(level, answer)
    return 0
}
