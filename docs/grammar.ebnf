/* The Come Language Grammar (EBNF) - v1.0
 *
 * This is the published grammar for Come v1. It describes
 * exactly the language the compiler accepts: every
 * production is exercised by the test corpus, and the
 * conformance checks in tests/run_grammar_test.sh compare
 * this grammar, the lexer's keyword set, and spec section
 * 16 against each other and against the corpus.
 *
 * Notation: { x } = zero or more, [ x ] = optional,
 * | = alternative, "lit" = a terminal. A newline ends a
 * statement (spec 15); ";" may be written anywhere a
 * newline may, and separates statements on one line.
 * The keywords "as", "packed", and "align" are contextual:
 * they are ordinary identifiers outside the positions
 * shown. The lexer also reserves "method", a legacy
 * in-struct declaration marker that is not part of this
 * grammar and is unused by the corpus.
 */

/* 1. Program structure (spec 2, 3) */

program        = module_decl { top_level_decl } ;
module_decl    = "module" identifier ;

top_level_decl = import_stmt
               | export_decl
               | const_decl
               | alias_decl
               | struct_decl
               | union_decl
               | function_decl
               | coroutine_decl
               | extern_decl
               | lifecycle_decl
               ;

/* 2. Imports and exports (spec 3.1, 3.2, 3.4) */

import_stmt    = "import" import_target { "," import_target }
               | "import" "(" import_target { "," import_target } [ "," ] ")" ;
import_target  = identifier [ "as" identifier ] ;
export_decl    = "export" "(" export_item { "," export_item } [ "," ] ")" ;
export_item    = identifier                 /* a name declared in the module */
               | type identifier            /* a declaration entry */
               | function_signature ;       /* a signature entry */

/* 3. Constants and enumerations (spec 4) */

const_decl     = "const" const_item
               | "const" "(" const_item { "," const_item } [ "," ] ")" ;
const_item     = identifier "=" ( expression | enum_value ) ;
enum_value     = "enum" [ "(" expression ")" ] ;

/* 4. Aliases (spec 5) */

alias_decl     = "alias" identifier "=" ( type | expression | dotted_name )
               | "alias" identifier "(" identifier { "," identifier } ")"
                     "=" expression
               | "alias" "(" identifier { "," identifier } ")"
                     "=" "(" type { "," type } ")" ;
dotted_name    = identifier { "." identifier } ;
               /* a call alias's target, e.g. std.out.printf (spec 5.3) */

/* 5. Types (spec 6) */

type           = primitive_type
               | "string"
               | "link"
               | "struct" identifier
               | "union" identifier
               | identifier           /* struct, union, or alias name */
               | array_type
               | map_type
               | "&" "(" "struct" identifier ")"   /* reference (spec 6.2) */
               ;
array_type     = type "[" [ integer ] "]" ;
map_type       = "map" "{" type "," type "}" ;

primitive_type = "bool"
               | "byte"   | "ubyte"
               | "short"  | "ushort"
               | "int"    | "uint"
               | "long"   | "ulong"
               | "float"  | "double"
               | "wchar"
               | "void"
               ;
/* The spellings i8 i16 i32 i64 u8 u16 u32 u64 f32 f64
 * are aliases for the primitives above (spec 6.1). */

tuple_type     = "(" type { "," type } ")" ;   /* return types only */

/* 6. Composite declarations (spec 6.2, 6.3) */

struct_decl    = [ "packed" ] [ "align" "(" integer ")" ] "struct" identifier
                 "{" { struct_member } "}" ;
struct_member  = type identifier [ array_dim ] ;
union_decl     = "union" identifier "{" { struct_member } "}" ;
array_dim      = "[" [ expression ] "]" ;

/* 7. Functions (spec 8) */

function_decl  = function_signature ( block | ";" ) ;
function_signature
               = return_type function_name "(" [ param_list ] ")" ;
function_name  = identifier
               | identifier "." identifier ;  /* struct method (spec 6.2) */
return_type    = type | tuple_type ;
param_list     = param { "," param } ;
param          = type identifier [ array_dim ]
               | return_type identifier "(" [ param_list ] ")" ;
               /* a function passed as an argument is written
                * in declaration shape (spec 8.3) */

lifecycle_decl = "void" ( "module_create" | "module_destroy" ) "(" ")" block ;

/* 8. Coroutines (spec 9) */

coroutine_decl = "coroutine" identifier "(" [ param_list ] ")" block ;

/* 9. Foreign functions (spec 13; system modules only) */

extern_decl    = "extern" string_literal function_signature ";" ;

/* 10. Statements (spec 10, 11, 15) */

block          = "{" { statement } "}" ;

statement      = block
               | var_decl
               | destructure_stmt
               | assignment
               | if_stmt
               | switch_stmt
               | loop_stmt
               | return_stmt
               | spawn_stmt
               | "yield"
               | "break"
               | "continue"
               | "fallthrough"
               | expression_stmt
               | ";" ;

var_decl       = ( type | "var" ) identifier [ array_dim ]
                 [ "=" expression ] ;
destructure_stmt
               = "(" identifier "," identifier ")" "="
                 ( "colink" "(" ")" | expression ) ;
assignment     = lvalue assign_op expression ;
assign_op      = "=" | "+=" | "-=" | "*=" | "/=" | "%="
               | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

if_stmt        = "if" "(" expression ")" statement
                 [ "else" statement ] ;

switch_stmt    = "switch" "(" expression ")" "{"
                 { case_clause } [ default_clause ] "}" ;
case_clause    = "case" expression ":" { statement } ;
default_clause = "default" ":" { statement } ;
/* A case does not fall through unless its last statement
 * is "fallthrough" (spec 11.2). */

loop_stmt      = for_stmt | while_stmt | do_while_stmt ;
for_stmt       = "for" "(" [ simple_stmt ] ";" [ expression ] ";"
                 [ simple_stmt ] ")" statement ;
simple_stmt    = var_decl | assignment | expression ;
while_stmt     = "while" "(" expression ")" statement ;
do_while_stmt  = "do" statement "while" "(" expression ")" ;

return_stmt    = "return" [ expression { "," expression } ] ;
spawn_stmt     = "spawn" identifier "(" [ arg_list ] ")" ;
expression_stmt
               = expression ;

/* 11. Expressions (spec 14; precedence low to high) */

expression     = ternary_expr ;
ternary_expr   = logic_or [ "?" expression ":" ternary_expr ] ;
logic_or       = logic_and { "||" logic_and } ;
logic_and      = bit_or { "&&" bit_or } ;
bit_or         = bit_xor { "|" bit_xor } ;
bit_xor        = bit_and { "^" bit_and } ;
bit_and        = equality { "&" equality } ;
equality       = relational { ( "==" | "!=" ) relational } ;
relational     = shift { ( "<" | ">" | "<=" | ">=" ) shift } ;
shift          = additive { ( "<<" | ">>" ) additive } ;
additive       = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative = unary { ( "*" | "/" | "%" ) unary } ;
unary          = ( "!" | "-" | "~" | "&" | "++" | "--" ) unary | postfix ;
/* "&" is the scanf-style address form used by the std
 * library's input calls; it is not a general pointer
 * operator (spec 7.1: no raw pointers in user code). */

postfix        = primary { accessor | "++" | "--" } ;
accessor       = "." identifier
               | "[" expression "]"
               | "(" [ arg_list ] ")" ;
arg_list       = expression { "," expression } ;

primary        = literal
               | identifier
               | "(" expression ")"
               | "colink" "(" ")"
               | "wait" "(" expression { "," expression } ")"
               ;

/* ("(a, b) = colink()" and "(a, b) = f()" are statements,
 * see destructure_stmt; "wait" and "colink" are builtins,
 * not keywords.) */

/* 12. Literals and lexical structure (spec 2.2, 6, 15) */

literal        = integer
               | float_literal
               | string_literal
               | char_literal
               | "true" | "false"
               | array_literal
               | map_literal
               | struct_literal
               ;
array_literal  = "{" [ expression { "," expression } [ "," ] ] "}" ;
map_literal    = "{" [ map_entry { "," map_entry } [ "," ] ] "}" ;
map_entry      = expression ":" expression ;
struct_literal = "{" [ "." identifier "=" expression
                 { "," "." identifier "=" expression } [ "," ] ] "}" ;

integer        = digit { [ "'" ] digit } [ "L" ]
               | "0x" hex_digit { hex_digit } ;
float_literal  = digit { digit } "." digit { digit }
                 [ ( "e" | "E" ) [ "+" | "-" ] digit { digit } ] ;
char_literal   = "'" character "'" ;   /* byte or wchar by context */
string_literal = '"' { character } '"' ;

identifier     = letter { letter | digit | "_" } ;

/* Comments: a line comment starts with two slashes and
 * runs to end of line; block comments are delimited by
 * slash-star and star-slash. A newline terminates a
 * statement; ";" is an optional statement separator
 * (spec 15). */
